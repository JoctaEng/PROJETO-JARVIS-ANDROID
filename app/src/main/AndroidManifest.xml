<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PoC 0.1: personagem flutuante -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Estado da rede para o orquestrador (online/offline) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Fase 1: cérebro online (APIs e servidor próprio) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- PoC 0.2 e 0.4: microfone e câmera, só durante a sessão iniciada pelo toque -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Fase 1: ações no celular (ADR 0011) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Visibilidade de pacotes (Android 11+) para reconhecimento de voz e TTS -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Abrir apps pelo nome -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Apps do celular que oferecem ferramentas MCP ao Euno (ex.: EduMath) -->
        <intent>
            <action android:name="com.joctaeng.euno.action.MCP_SERVER" />
        </intent>
    </queries>

    <application
        android:name=".JarvisApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_jarvis"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jarvis"
        android:usesCleartextTraffic="true">
        <!-- Cleartext: permite o servidor próprio na rede local (http://IP:11434). APIs públicas usam HTTPS. -->

        <!-- Necessário para o backend GPU do LiteRT-LM (OpenCL) -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Conversa: abre pelo toque no personagem, por cima do app atual -->
        <activity
            android:name=".chat.ChatActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.joctaeng.jarvis.chat"
            android:theme="@style/Theme.Jarvis.Translucent"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.DiagnosticsActivity"
            android:exported="false" />

        <!-- PoC 0.2: sessão de teste de microfone e câmera (aberta pelo Diagnóstico) -->
        <activity
            android:name=".session.TouchSessionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.joctaeng.jarvis.session"
            android:theme="@style/Theme.Jarvis.Translucent" />

        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Personagem assistente flutuante exibido sobre outros apps e ativado pelo toque do usuário" />
        </service>
    </application>
</manifest>
